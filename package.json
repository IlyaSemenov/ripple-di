{
  "name": "ripple-di",
  "version": "3.3.0",
  "description": "Next-generation DI for TypeScript with async scopes, transitive overrides, and automatic resource cleanup.",
  "keywords": [
    "async-context",
    "async-hooks",
    "asynclocalstorage",
    "dependency-graph",
    "dependency-injection",
    "dependency-tracking",
    "di",
    "inversion-of-control",
    "ioc",
    "lifecycle",
    "scoped",
    "service-locator",
    "testing",
    "typescript"
  ],
  "homepage": "https://ilyasemenov.github.io/ripple-di/",
  "bugs": "https://github.com/IlyaSemenov/ripple-di/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/ripple-di.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/shared.mjs"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./shared": "./dist/shared.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "lefthook install",
    "test": "bun test",
    "smoke": "node tests/smoke.mjs",
    "types": "bun check && bun check -p tests",
    "prepublishOnly": "bun run build",
    "release": "changesets-release",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "changesets-release": "^2.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "bun@1.4.4"
}
